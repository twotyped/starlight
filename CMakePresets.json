{
    "version": 6,
    "configurePresets": [
        {
            "name": "vcpkg",
            "displayName": "CMake with vcpkg manifest",
            "binaryDir": "${sourceDir}/build-vcpkg",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vcpkg",
            "configurePreset": "vcpkg",
            "configuration": "Debug"
        }
    ]
}